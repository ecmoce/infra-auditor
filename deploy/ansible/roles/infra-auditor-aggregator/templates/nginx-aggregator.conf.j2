# {{ ansible_managed }}
# nginx 설정 for infra-auditor-aggregator

upstream infra_auditor_backend {
    server {{ aggregator_bind_address }}:{{ aggregator_port }} max_fails=3 fail_timeout=30s;
}

{% if enable_ssl %}
# HTTP to HTTPS redirect
server {
    listen {{ nginx_port }};
    server_name {{ ansible_fqdn }} {{ ansible_hostname }};
    return 301 https://$server_name$request_uri;
}

# HTTPS server
server {
    listen {{ nginx_ssl_port }} ssl http2;
    server_name {{ ansible_fqdn }} {{ ansible_hostname }};
    
    # SSL 설정
    ssl_certificate {{ ssl_cert_path }};
    ssl_certificate_key {{ ssl_key_path }};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-RSA-AES256-GCM-SHA512:DHE-RSA-AES256-GCM-SHA512:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    
    # 보안 헤더
    add_header Strict-Transport-Security "max-age=63072000" always;
    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options DENY;
    add_header X-XSS-Protection "1; mode=block";
{% else %}
# HTTP server
server {
    listen {{ nginx_port }};
    server_name {{ ansible_fqdn }} {{ ansible_hostname }};
{% endif %}
    
    # 로깅
    access_log {{ aggregator_log_path }}/nginx_access.log;
    error_log {{ aggregator_log_path }}/nginx_error.log;
    
    # gzip 압축
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;
    
    # 클라이언트 설정
    client_max_body_size 50m;
    client_body_timeout 60s;
    client_header_timeout 60s;
    
    # 프록시 설정
    location / {
        proxy_pass http://infra_auditor_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # 타임아웃
        proxy_connect_timeout 30s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        
        # 버퍼링
        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
    }
    
    # API 엔드포인트 (더 긴 타임아웃)
    location /api/ {
        proxy_pass http://infra_auditor_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # 긴 타임아웃 (복잡한 쿼리용)
        proxy_connect_timeout 30s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }
    
    # 메트릭 엔드포인트 (Prometheus)
    location /metrics {
        proxy_pass http://infra_auditor_backend;
        proxy_set_header Host $host;
        
        # IP 기반 접근 제한 (옵션)
        # allow 10.0.0.0/8;
        # allow 172.16.0.0/12;
        # allow 192.168.0.0/16;
        # deny all;
    }
    
    # 헬스체크 엔드포인트
    location /health {
        proxy_pass http://infra_auditor_backend;
        access_log off;
        proxy_connect_timeout 5s;
        proxy_send_timeout 5s;
        proxy_read_timeout 5s;
    }
    
    # 정적 파일
    location /static/ {
        alias {{ dashboard_static_path | default('/var/lib/infra-auditor/static') }}/;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    
    # favicon.ico
    location = /favicon.ico {
        access_log off;
        log_not_found off;
        expires 1y;
    }
    
    # robots.txt
    location = /robots.txt {
        access_log off;
        log_not_found off;
        return 200 "User-agent: *\nDisallow: /\n";
    }
}