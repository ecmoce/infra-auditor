# {{ ansible_managed }}
# systemd 서비스 파일 for infra-auditor-aggregator

[Unit]
Description=Infra Auditor Aggregator Service
Documentation=https://github.com/ecmoce/infra-auditor
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ service_user }}
Group={{ service_group }}
ExecStart={{ aggregator_binary_path }} --config {{ aggregator_config_path }}
ExecReload=/bin/kill -HUP $MAINPID
KillMode=mixed
Restart=always
RestartSec=5
LimitNOFILE=65536

# 보안 설정
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths={{ aggregator_data_path }} {{ aggregator_log_path }}
PrivateTmp=yes
PrivateDevices=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes

# 리소스 제한
MemoryLimit={{ memory_limit | default(1024) }}M
TasksMax=4096

# 환경 변수
Environment=CONFIG_PATH={{ aggregator_config_path }}
Environment=DATA_PATH={{ aggregator_data_path }}
Environment=LOG_PATH={{ aggregator_log_path }}

# 로깅
StandardOutput=journal
StandardError=journal
SyslogIdentifier={{ service_name }}

[Install]
WantedBy=multi-user.target